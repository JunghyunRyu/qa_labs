# ============================================
# QA-Arena 통합 환경 변수 설정
# ============================================
# 이 파일을 .env로 복사하여 사용하세요.
# 절대로 실제 키 값을 Git에 커밋하지 마세요!

# ============================================
# 환경 구분
# ============================================
ENVIRONMENT=development
# Options: development, staging, production

DEBUG=False

# ============================================
# PostgreSQL 데이터베이스
# ============================================
POSTGRES_USER=qa_arena_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=qa_arena

# Docker 내부 연결용 (docker-compose에서 자동 구성)
# DATABASE_URL은 docker-compose에서 직접 설정됨

# ============================================
# Redis
# ============================================
# Docker 내부 연결용 (docker-compose에서 자동 구성)
# REDIS_URL은 docker-compose에서 직접 설정됨

# ============================================
# CORS 설정
# ============================================
# JSON 배열 형태로 작성
CORS_ORIGINS=["http://localhost:3000"]
# Production: CORS_ORIGINS=["https://your-domain.com"]

# ============================================
# OpenAI API (AI 기능)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_REASONING_EFFORT=medium
# Reasoning effort: none, low, medium, high, xhigh

# AI Coach
OPENAI_AI_COACH_MODEL=gpt-4o-mini

# ============================================
# GitHub OAuth
# ============================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ============================================
# JWT 인증
# ============================================
# 최소 32자 이상의 랜덤 문자열 사용
# 생성: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 쿠키 설정
# ============================================
COOKIE_SECURE=false
# Production: COOKIE_SECURE=true (HTTPS 필수)
COOKIE_SAMESITE=lax

# ============================================
# Frontend URL
# ============================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# ============================================
# Nginx 포트 (Production)
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# Google Analytics 4 (선택)
# ============================================
# GA4 측정 ID (프로덕션 전용)
NEXT_PUBLIC_GA_ID=

# ============================================
# Sentry 에러 트래킹 (권장)
# ============================================
# Backend Sentry DSN (Python/FastAPI/Celery)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/backend-project-id

# Frontend Sentry DSN (Next.js)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/frontend-project-id
NEXT_PUBLIC_ENVIRONMENT=development

# 성능 모니터링 샘플링 비율 (0.0 ~ 1.0)
# 개발: 1.0, 프로덕션: 0.1 권장
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Worker 모니터링
# ============================================
WORKER_MONITOR_ENABLED=true
WORKER_MONITOR_INTERVAL_SECONDS=30
WORKER_DOWN_THRESHOLD=3

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GUEST_SUBMISSIONS=5/minute
RATE_LIMIT_GUEST_SUBMISSIONS_DAILY=30/day
RATE_LIMIT_MEMBER_SUBMISSIONS=10/minute
RATE_LIMIT_MEMBER_SUBMISSIONS_DAILY=200/day
